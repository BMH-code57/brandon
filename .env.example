# Copy to .env.local for local development. Never commit real values.
SECRET_PASSWORD_VERIFIER=pbkdf2-sha256:100000:salt:derived-hash
SECRET_SESSION_KEY=replace-with-at-least-32-random-characters
SECRET_ALLOWED_ORIGIN=http://localhost:3000
# Set the exact production origin in Vercel, such as https://brandonholda.com.
# Vercel's injected deployment URL is also accepted for deployment previews.

# Create an Upstash Redis database through Vercel Storage or Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CAVERN_REDIS_PREFIX=brandon-cavern

# Optional private collection JSON. Never use NEXT_PUBLIC_ for these values.
QUIET_CHAMBER_CONTENT=
# Existing split collections remain supported. New imports can use one variable.
QUIET_CHAMBER_CONTENT_2=
QUIET_CHAMBER_CONTENT_3=
QUIET_CHAMBER_CONTENT_4=
HEVY_API_KEY=
# The receipt lives in private Redis storage, not environment variables.

# Separate owner access for the public article board. Never share the editor key.
QUEST_EDITOR_KEY_HASH=
