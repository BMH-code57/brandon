# Generate a random access password. Never put the plaintext password in source.
SECRET_PASSWORD_VERIFIER=pbkdf2-sha256:100000:salt:derived-hash
SECRET_SESSION_KEY=replace-with-at-least-32-random-characters
SECRET_ALLOWED_ORIGIN=http://terminal.local:4173
# Optional JSON containing League profile links, season notes, and watched anime.
# See docs/quiet-chamber-content.md. Keep personal lists out of the public repo.
QUIET_CHAMBER_CONTENT=
