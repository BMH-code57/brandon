# Generate a random access password. Never put the plaintext password in source.
SECRET_PASSWORD_VERIFIER=pbkdf2-sha256:100000:salt:derived-hash
SECRET_SESSION_KEY=replace-with-at-least-32-random-characters
SECRET_ALLOWED_ORIGIN=http://terminal.local:4173
# Optional JSON containing League profile links, season notes, and watched anime.
# See docs/quiet-chamber-content.md. Keep personal lists out of the public repo.
QUIET_CHAMBER_CONTENT=
# Optional continuation chunks for collections above the per-value host limit.
QUIET_CHAMBER_CONTENT_2=
QUIET_CHAMBER_CONTENT_3=
QUIET_CHAMBER_CONTENT_4=
# Optional server-only key from https://hevy.com/settings?developer
HEVY_API_KEY=

# Optional private WebP receipt, base64 split into ordered 4000-character chunks.
LEAGUE_RECEIPT_1=
LEAGUE_RECEIPT_2=
LEAGUE_RECEIPT_3=
LEAGUE_RECEIPT_4=
LEAGUE_RECEIPT_5=
LEAGUE_RECEIPT_6=
LEAGUE_RECEIPT_7=
LEAGUE_RECEIPT_8=
LEAGUE_RECEIPT_9=
LEAGUE_RECEIPT_10=
LEAGUE_RECEIPT_11=
LEAGUE_RECEIPT_12=
LEAGUE_RECEIPT_13=
LEAGUE_RECEIPT_14=
